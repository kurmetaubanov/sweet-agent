# A sample environment. The working copy is .env, and it is also the only place where
# the keys are edited by hand:
#
#   cp .env.example .env     # and fill it in
#   ./deploy.sh              # will lay the keys from .env out into files in secrets/
#   docker compose up -d
#
# .env itself is in .gitignore, this file is not. Empty values are not an accident: what is absent
# remains the value from config/config.exs, and not a failure (see config/runtime.exs).
# The exception is the model key: without it brain will come up, but the very first request
# to the provider will return a 401.


# ── Keys and tokens ─────────────────────────────────────────────────────────
# deploy.sh reads these five and lays them out into files in secrets/. As files,
# and not as variables: the hand reads out the environment of a container through the docker API
# (`docker top`), while mountings it does not. The values get into the containers
# as /run/secrets/*, see the secrets block in docker-compose.yml.

# The model key. Mandatory.
SWEET_ANTHROPIC_API_KEY=

# The telegram bot and whose chat it serves. Without them the entrance remains only through IEx
# (`docker attach sweet-brain`). The list of allowed ones is also a secret, and not a setting:
# it decides whose messages the bot accepts at all.
SWEET_TELEGRAM_BOT_TOKEN=
SWEET_TG_ALLOWED_USER_ID=

# Substituted by the egress filter on the way out: github.com and api.serpbase.dev. They do not get
# into the containers at all — the hand sees masks (below). Hence also the "default mask":
# empty — the hand sees nothing resembling a key.
SWEET_GITHUB_API_KEY=
SWEET_SERPBASE_API_KEY=


# ── Masks ───────────────────────────────────────────────────────────────────
# What the hand sees instead of the real keys. It is not obligatory to set them, but with
# them the hand can mention a key in a command and not give it away in the log.

SWEET_GITHUB_API_KEY_MASK=
SWEET_SERPBASE_API_KEY_MASK=


# ── Host paths ──────────────────────────────────────────────────────────────
# They are opened by the docker daemon of the HOST, and not by brain: the bind mounts a host folder.
# The defaults are designed for /home/maha/projects — on another machine change them here.
# PRIV — the memory of conversations and the inventory of sessions (two CubDB); substituting the folder means
# a start with a clean memory, and not a "move".

SWEET_PRIV_HOST_DIR=/home/maha/projects/sweet-agent/priv
SWEET_SECRETS_HOST_DIR=/home/maha/projects/sweet-agent/secrets
SWEET_CA_HOST_DIR=/home/maha/projects/sweet-agent/certs
SWEET_WORKSPACE_HOST_DIR=/home/maha/projects/kurmet-agent-space
SWEET_SKILLS_HOST_DIR=/home/maha/projects/sweet-agent/skills


# ── Docker filter ───────────────────────────────────────────────────────────
# The only door to docker: brain has no socket, there is TCP to the filter.
# ALLOWED_BINDS — the list of host folders that the hand is allowed to mount
# (empty = not one). DENIED_NETWORKS — where the hand must not connect: the network
# of brain and the network from which they go into the filter.

SWEET_DOCKER_FILTER_ALLOWED_BINDS=
SWEET_DOCKER_FILTER_DENIED_NETWORKS=sweet_ctl,sweet_world

# The gid of the docker group on the host. The hand needs it in order to read /var/run/docker.sock,
# which is passed through into docker-filter. On the host: `getent group docker`.
DOCKER_GID=999


# ── What the egress filter substitutes and where ────────────────────────────
# Fine tuning of the substitution of tokens: to which hosts, on which paths. Usually there is no
# need to touch it — the defaults are in docker-compose.yml.

GITHUB_INJECT_HOSTS=github.com,api.github.com
GITHUB_INJECT_PATHS=
GITHUB_INJECT_PATH_SUFFIXES=/info/refs,/git-upload-pack,/git-receive-pack,/
SERPBASE_INJECT_HOSTS=api.serpbase.dev
SERPBASE_INJECT_PATHS=/google/search
